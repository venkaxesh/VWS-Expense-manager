rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if true;
    }

    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
